#!/usr/bin/env bash
#SBATCH -J hssm-tst-singlesub
#SBATCH -p all
#SBATCH --ntasks=1
#SBATCH -c 1
#SBATCH --array=0-2
#SBATCH --time=1440
#SBATCH -o slurm-%A_%a.out
#SBATCH --mail-type=end
#SBATCH --mail-user=jungsuy@uci.edu

# enable -e and pipefail now; delay -u until after sourcing bashrc
set -e -o pipefail

# Safely source ~/.bashrc even if /etc/bashrc expects unset vars
if [ -f ~/.bashrc ]; then
  set +u
  source ~/.bashrc
  set -u
else
  # If you rely on conda but don't have ~/.bashrc, you can instead do:
  # eval "$(/path/to/miniconda3/bin/conda shell.bash hook)"
  :
fi

conda activate hssm

# JAX side must match PyMC (CPU + float64); keep if you're using the PyMC backend
export JAX_PLATFORM_NAME=cpu
export JAX_ENABLE_X64=true

SSC="${1}"
SUBJ="${2}"
CHAIN_ID="${SLURM_ARRAY_TASK_ID}"

python3 -u hssm-tst-singlesub.py \
  --ssc "${SSC}" \
  --subj "${SUBJ}" \
  --chain-id "${CHAIN_ID}" \
  --tune 2000 \
  --draws 1000 \
  --target_accept 0.90 \
  --max_treedepth 12
