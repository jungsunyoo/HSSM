#!/usr/bin/env bash
#SBATCH -J hssm-tst-singlesub
#SBATCH -p all
#SBATCH --ntasks=1
#SBATCH -c 1
#SBATCH --array=0-2
#SBATCH --time=1440
#SBATCH -o slurm-%A_%a.out
#SBATCH --mail-type=end
#SBATCH --mail-user=jungsuy@uci.edu

set -e -o pipefail   # no -u (nounset)!

# Load conda safely (site path may differ on your cluster)
if command -v conda >/dev/null 2>&1; then
  eval "$(conda shell.bash hook)"
else
  source /mnt/cup/PNI-facilities/Computing/sw/pkg/Rhel9/ANACONDAPY/2024.02/etc/profile.d/conda.sh
fi

conda activate hssm

# (Optional) align JAX to CPU/float64 if you’re on the PyMC path
export JAX_PLATFORM_NAME=cpu
export JAX_ENABLE_X64=true

SSC="$1"
SUBJ="$2"
CHAIN_ID="${SLURM_ARRAY_TASK_ID}"

python3 -u hssm-tst-singlesub.py \
  --ssc "$SSC" \
  --subj "$SUBJ" \
  --chain-id "$CHAIN_ID" \
  --tune 200 \
  --draws 100 \
  --target_accept 0.90 \
  --max_treedepth 5
