#!/usr/bin/env bash
#SBATCH -J hssm-tst-singlesub
#SBATCH -p all
#SBATCH --ntasks=1
#SBATCH -c 1
#SBATCH --array=0-2
#SBATCH --time=1440
#SBATCH -o slurm-%A_%a.out
#SBATCH --mail-type=end
#SBATCH --mail-user=jungsuy@uci.edu

set -euo pipefail

source ~/.bashrc
conda activate hssm

# JAX side must match PyMC (float64; CPU to avoid CUDA probe noise)
export JAX_PLATFORM_NAME=cpu
export JAX_ENABLE_X64=true

SSC="${1}"
SUBJ="${2}"
CHAIN_ID="${SLURM_ARRAY_TASK_ID}"

python3 -u hssm-tst-singlesub.py \
  --ssc "${SSC}" \
  --subj "${SUBJ}" \
  --chain-id "${CHAIN_ID}" \
  --tune 200 \
  --draws 100 \
  --target_accept 0.90 \
  --max_treedepth 5    # <-- try 5 ONCE to prove it's applied; change to 12 later
