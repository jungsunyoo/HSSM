#!/usr/bin/env bash
#SBATCH -J hssm-tst-singlesub      # job name
#SBATCH -p gpu                     # GPU partition (adjust if your site uses a different name)
#SBATCH --ntasks=1
#SBATCH -o slurm-%A_%a.out         # unique per array task
#SBATCH -c 1                       # 1 CPU per task
#SBATCH --array=0-2
#SBATCH --time=1440                # 24 hours (minutes format)
#SBATCH --mail-type=end
#SBATCH --mail-user=jungsuy@uci.edu
#SBATCH --gres=gpu:1               # request 1 GPU

# If your cluster prefers the newer syntax, you can use:
# #SBATCH --gpus-per-task=1

# module load python/3.11  # or your env activation
# source ~/envs/hssm/bin/activate
# module load miniconda3
source ~/.bashrc
conda activate hssm

# JAX on GPU, avoid preallocating whole GPU memory
export JAX_PLATFORM_NAME=gpu
export XLA_PYTHON_CLIENT_PREALLOCATE=false

# This next line just runs the python script (GPU single-subject version)
python3 -u hssm-tst-singlesub-gpu.py \
  --ssc "${1}" \
  --subj "${2}" \
  --chain-id "${SLURM_ARRAY_TASK_ID}" \
  --draws 10000 \
  --tune 10000

# If you prefer to keep the CPU script name, you can call hssm-tst-singlesub.py here;
# the env vars above will still force JAX to use the GPU.

exit
